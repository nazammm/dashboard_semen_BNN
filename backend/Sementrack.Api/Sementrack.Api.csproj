<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sementrack.Api</RootNamespace>
    <AssemblyName>Sementrack.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sementrack.Core\Sementrack.Core.csproj" />
  </ItemGroup>

  <!-- Build normal (mesin dengan akses NuGet): paket asli -->
  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <!-- Hanya untuk pemeriksaan kompilasi tanpa NuGet: dotnet build -p:UseStubs=true -->
  <ItemGroup Condition="'$(UseStubs)' == 'true'">
    <ProjectReference Include="..\stubs\Stubs.csproj" />
  </ItemGroup>
</Project>
